# ---------------------------------------------------------------------------
# LDAP / Active Directory authentication (ophix-auth-ldap)
#
# LDAP is activated when LDAP_SERVER_URI is set. It handles the standard
# Django admin username/password form — users are auto-provisioned on first
# login if they authenticate successfully against AD.
#
# LDAP and SSO can be active simultaneously.
#
# LDAP_SERVER_URI uses ldap:// (plain or STARTTLS) or ldaps:// (TLS from
# the start). For Active Directory, ldap:// with LDAP_START_TLS=True is
# the standard approach. Use ldaps:// on port 636 for a direct TLS connection.
#
# LDAP_BIND_DN / LDAP_BIND_PASSWORD: service account used to search the
# directory. Use a dedicated read-only account, not a user or admin account.
# Format: CN=svc-ophix,OU=Service Accounts,DC=company,DC=local
#
# LDAP_USER_SEARCH_BASE: where to search for user accounts.
# Example: DC=company,DC=local
#
# LDAP_GROUP_SEARCH_BASE: where to search for groups (defaults to
# LDAP_USER_SEARCH_BASE if not set).
#
# LDAP_STAFF_GROUP / LDAP_SUPERUSER_GROUP: full DN of the AD group whose
# members receive Django staff / superuser status. Re-evaluated on every login.
# Example: CN=Ophix-Admins,OU=Groups,DC=company,DC=local
#
# LDAP_REQUIRE_GROUP: optional. Only members of this group can log in at all.
# Leave blank to allow any valid AD user to authenticate.
#
# LDAP_START_TLS: set to True to use STARTTLS on a plain ldap:// connection.
#
# LDAP_LOG_LEVEL: set to DEBUG to log bind attempts, group queries, and the
# reason for each login failure to the console / systemd journal. Leave unset
# or set to WARNING in production.
# ---------------------------------------------------------------------------

# LDAP_SERVER_URI=ldap://dc.company.local
# LDAP_BIND_DN=CN=svc-ophix,OU=Service Accounts,DC=company,DC=local
# LDAP_BIND_PASSWORD=
# LDAP_USER_SEARCH_BASE=DC=company,DC=local
# LDAP_GROUP_SEARCH_BASE=DC=company,DC=local
# LDAP_STAFF_GROUP=CN=Ophix-Staff,OU=Groups,DC=company,DC=local
# LDAP_SUPERUSER_GROUP=CN=Ophix-Admins,OU=Groups,DC=company,DC=local
# LDAP_REQUIRE_GROUP=
# LDAP_START_TLS=False
# LDAP_LOG_LEVEL=WARNING
